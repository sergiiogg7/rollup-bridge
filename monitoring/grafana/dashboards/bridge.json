{
  "uid": "rollup-bridge",
  "title": "Rollup bridge",
  "tags": ["rollup-bridge"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "editable": false,
  "panels": [
    {"id": 1, "type": "stat", "title": "Deposits pending", "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prom"},
     "targets": [{"refId": "A", "expr": "max(bridge_deposits_pending)"}]},
    {"id": 2, "type": "stat", "title": "Oldest pending deposit (s)", "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prom"},
     "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 300}]}}, "overrides": []},
     "targets": [{"refId": "A", "expr": "max(bridge_deposit_oldest_pending_age_seconds)"}]},
    {"id": 3, "type": "stat", "title": "L1 confirmations waiting", "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prom"},
     "targets": [{"refId": "A", "expr": "max(bridge_l1_confirmations_waiting)"}]},
    {"id": 4, "type": "stat", "title": "Outputs proposed / challenged", "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prom"},
     "targets": [
       {"refId": "A", "legendFormat": "proposed", "expr": "sum(bridge_outputs_proposed_total)"},
       {"refId": "B", "legendFormat": "challenged", "expr": "sum(bridge_outputs_challenged_total)"}]},
    {"id": 5, "type": "stat", "title": "Bridge paused", "gridPos": {"x": 18, "y": 0, "w": 3, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prom"},
     "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "no"}, "1": {"text": "PAUSED"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
     "targets": [{"refId": "A", "expr": "max(bridge_l1_paused)"}]},
    {"id": 6, "type": "stat", "title": "Alerts firing", "gridPos": {"x": 21, "y": 0, "w": 3, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prom"},
     "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
     "targets": [{"refId": "A", "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)"}]},

    {"id": 7, "type": "timeseries", "title": "Deposits by state", "gridPos": {"x": 0, "y": 4, "w": 8, "h": 7},
     "datasource": {"type": "prometheus", "uid": "prom"},
     "targets": [{"refId": "A", "legendFormat": "{{state}}", "expr": "max by (state) (bridge_deposits_by_state)"}]},
    {"id": 8, "type": "timeseries", "title": "Withdrawals by state", "gridPos": {"x": 8, "y": 4, "w": 8, "h": 7},
     "datasource": {"type": "prometheus", "uid": "prom"},
     "targets": [{"refId": "A", "legendFormat": "{{state}}", "expr": "max by (state) (bridge_withdrawals_by_state)"}]},
    {"id": 9, "type": "timeseries", "title": "Outputs by status (newest 64)", "gridPos": {"x": 16, "y": 4, "w": 8, "h": 7},
     "datasource": {"type": "prometheus", "uid": "prom"},
     "targets": [{"refId": "A", "legendFormat": "{{status}}", "expr": "max by (status) (bridge_outputs)"}]},

    {"id": 10, "type": "timeseries", "title": "Challenge window left (s): closest open output vs closest UNCHECKED one", "gridPos": {"x": 0, "y": 11, "w": 12, "h": 7},
     "datasource": {"type": "prometheus", "uid": "prom"},
     "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
     "targets": [
       {"refId": "A", "legendFormat": "any open output", "expr": "min(bridge_open_output_min_window_remaining_seconds)"},
       {"refId": "B", "legendFormat": "unchecked by the challenger", "expr": "min(bridge_unchecked_output_min_window_remaining_seconds)"},
       {"refId": "C", "legendFormat": "alert threshold (50% of the window)", "expr": "0.5 * max(bridge_challenge_window_seconds)"}]},
    {"id": 11, "type": "timeseries", "title": "Cursor lag per chain (blocks)", "gridPos": {"x": 12, "y": 11, "w": 6, "h": 7},
     "datasource": {"type": "prometheus", "uid": "prom"},
     "targets": [{"refId": "A", "legendFormat": "{{chain}}", "expr": "max by (chain) (bridge_cursor_lag_blocks)"}]},
    {"id": 12, "type": "timeseries", "title": "Chain heads", "gridPos": {"x": 18, "y": 11, "w": 6, "h": 7},
     "datasource": {"type": "prometheus", "uid": "prom"},
     "targets": [{"refId": "A", "legendFormat": "{{chain}}", "expr": "max by (chain) (bridge_chain_head_block)"}]},

    {"id": 13, "type": "timeseries", "title": "Service errors (increase, 5 m) by service and reason", "gridPos": {"x": 0, "y": 18, "w": 12, "h": 7},
     "datasource": {"type": "prometheus", "uid": "prom"},
     "targets": [{"refId": "A", "legendFormat": "{{service}} / {{reason}}", "expr": "sum by (service, reason) (increase(bridge_service_errors_total[5m]))"}]},
    {"id": 14, "type": "timeseries", "title": "Deposit latency, first seen to minted (s)", "gridPos": {"x": 12, "y": 18, "w": 6, "h": 7},
     "datasource": {"type": "prometheus", "uid": "prom"},
     "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
     "targets": [
       {"refId": "A", "legendFormat": "p50", "expr": "histogram_quantile(0.5, sum by (le) (increase(bridge_deposit_latency_seconds_bucket[15m])))"},
       {"refId": "B", "legendFormat": "p95", "expr": "histogram_quantile(0.95, sum by (le) (increase(bridge_deposit_latency_seconds_bucket[15m])))"}]},
    {"id": 15, "type": "timeseries", "title": "Seconds since each service last completed a tick", "gridPos": {"x": 18, "y": 18, "w": 6, "h": 7},
     "datasource": {"type": "prometheus", "uid": "prom"},
     "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
     "targets": [{"refId": "A", "legendFormat": "{{service}}", "expr": "time() - max by (service) (bridge_service_last_success_timestamp_seconds)"}]},

    {"id": 16, "type": "timeseries", "title": "Transactions sent (rate per minute) by service, operation and outcome", "gridPos": {"x": 0, "y": 25, "w": 12, "h": 7},
     "datasource": {"type": "prometheus", "uid": "prom"},
     "targets": [{"refId": "A", "legendFormat": "{{service}} {{op}} {{outcome}}", "expr": "sum by (service, op, outcome) (increase(bridge_transactions_total[1m]))"}]},
    {"id": 17, "type": "table", "title": "Alerts", "gridPos": {"x": 12, "y": 25, "w": 12, "h": 7},
     "datasource": {"type": "prometheus", "uid": "prom"},
     "targets": [{"refId": "A", "format": "table", "instant": true, "expr": "ALERTS{alertstate=\"firing\"}"}]}
  ]
}
