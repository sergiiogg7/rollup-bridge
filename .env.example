# Configuration of the Java services (environment variables only).
# EVERY key below is a public Anvil TEST key: it controls nothing of value on any real network.
# Never put a real private key in this file or in a repo.

L1_RPC=http://127.0.0.1:18545
L2_RPC=http://127.0.0.1:19545
L1_CHAIN_ID=31337
L2_CHAIN_ID=901

# Contract addresses. If unset they are read from deployments/l1.json and deployments/l2.json,
# which `forge script script/LocalDeploy.s.sol` writes.
# OUTPUT_ORACLE=0x...
# L1_BRIDGE=0x...
# L2_BRIDGE=0x...

# One key per role (Anvil accounts 1 to 4)
RELAYER_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
PROPOSER_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
CHALLENGER_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6
GUARDIAN_KEY=0x47e179ec197488593b187f80a00eb0da91f1b9d0b13f8733639f19c30a34926a

# Blocks the deposit relayer waits before minting on L2. 0 is UNSAFE (see docs/THREAT-MODEL.md, reorgs).
DEPOSIT_CONFIRMATIONS=2
# First L1 block to scan for deposits (the deployment block).
L1_START_BLOCK=0
POLL_MS=1000
# CHALLENGER_POLL_MS=1000
DB_DIR=.data
# Plain-text status page of `all` (0 = off)
STATUS_PORT=0
